			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Tes 1: Memvalidasi Status Code adalah 200 (OK)\r",
							"pm.test(\"Status code adalah 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Tes 2: Memvalidasi bahwa response adalah JSON\r",
							"pm.test(\"Response adalah JSON\", function () {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"// Tes 3: Memvalidasi bahwa ada 6 pengguna di halaman 2\r",
							"pm.test(\"Total pengguna di halaman ini adalah 6\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.per_page).to.eql(6);\r",
							"    pm.expect(jsonData.data.length).to.eql(6);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
