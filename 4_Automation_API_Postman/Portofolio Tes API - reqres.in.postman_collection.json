							"});\r",
							"\r",
							"// Tes 2: Memvalidasi bahwa nama di response SAMA dengan yang kita kirim\r",
							"pm.test(\"Nama pengguna di response sesuai dengan request body\", function () {\r",
							"    var jsonData = pm.response.json();\r",
